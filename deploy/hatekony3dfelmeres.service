[Unit]
Description=hatekony3dfelmeres.hu (site-8)
After=network.target

[Service]
Type=simple
User=h3df-site8
Group=h3df-site8
WorkingDirectory=/srv/site-8
EnvironmentFile=/srv/site-8/.env
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=8000
ExecStart=/usr/bin/node src/server.js
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/site-8/data

[Install]
WantedBy=multi-user.target
