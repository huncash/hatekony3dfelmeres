# hatekony3dfelmeres.hu — site-8
# Másolat: .env  (a .env nem kerül verziókezelésbe, titkot ne írjon ebbe a példafájlba)

SITE_NAME=Hatékony 3D felmérés
SITE_URL=https://hatekony3dfelmeres.hu
PORT=8000
HOST=127.0.0.1

# Saját fájl. Ne mutasson a site-1, site-6 vagy site-7 adatára.
DATABASE_URL=file:./data/leads.sqlite

CONTACT_EMAIL=info@hatekony3dfelmeres.hu
COMPANY_PHONE=+36 30 667 2510

# Levélküldés. Jelszó és felhasználó csak a helyi .env-ben legyen.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Admin felület jelszava. Üresen az /admin ki van kapcsolva.
# Generálás: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_TOKEN=
# A süti aláírása. Lehet külön a jelszótól; ha üres, az ADMIN_TOKEN a titok.
SESSION_SECRET=

# Cégadatok (nyilvános cégjegyzéki adatok, felülírhatók)
COMPANY_LEGAL_NAME=ADP-TOP Kereskedelmi és Szolgáltató Korlátolt Felelősségű Társaság
COMPANY_SHORT_NAME=ADP-TOP Kft.
COMPANY_SEAT=1116 Budapest, Híradó utca 29.
COMPANY_STREET=Híradó utca 29.
COMPANY_POSTAL=1116
COMPANY_CITY=Budapest
COMPANY_TAX_ID=13777164-2-43
COMPANY_EU_TAX_ID=HU13777164
COMPANY_REG_NO=01-09-872622
COMPANY_COURT=Fővárosi Törvényszék Cégbírósága
COMPANY_MAIN_ACTIVITY=4712 – Iparcikk jellegű vegyes kiskereskedelem

# Ha a tárhelyszerződés szerint közzé kell tenni a szolgáltatót, ide kerül a neve és elérhetősége.
HOSTING_NOTE=
